{
  "routes": [
    { "method": "GET", "path": "/api/apps/document/templates",
      "response": {"items": [{"id": "string", "name": "string", "group": "string", "groupName": "string", "purpose": "string", "inputs": [["string", "string", "string"]], "kind": "string"}], "groups": [["string", "string"]]} },
    { "method": "GET", "path": "/api/apps/document/documents",
      "response": {"items": [{"id": "string", "title": "string", "templateId": "string", "status": "string", "author": "string", "updated": "string", "versions": "number", "comments": "number"}]} },
    { "method": "POST", "path": "/api/apps/document/drafts",
      "response": {"item": "@draft"},
      "body": {"templateId": "T01", "inputs": {"title": "契约测试示例", "target": "测试单位", "effect": "2026-12-01"},
               "extra": ["公开合成告知单第一行\n第二行"]},
      "save": "draft" },
    { "method": "GET", "path": "/api/apps/document/drafts/{id}",
      "response": {"item": "@draft"},
      "params": {"id": "{{draft.item.id}}"} },
    { "method": "PUT", "path": "/api/apps/document/drafts/{id}",
      "response": {"item": "@draft"},
      "body": {"content": "{{draft.item.versions.0.content}}", "note": "契约测试"},
      "params": {"id": "{{draft.item.id}}"} },
    { "method": "POST", "path": "/api/apps/document/compare",
      "response": {"parts": ["@diffPart"], "stats": {"add": "number", "del": "number"}},
      "body": {"a": "契约初稿", "b": "契约修订稿"} },
    { "method": "POST", "path": "/api/apps/document/drafts/{id}/check",
      "response": {"issues": ["@checkIssue"]},
      "body": {},
      "params": {"id": "{{draft.item.id}}"} },
    { "method": "POST", "path": "/api/apps/document/drafts/{id}/fix",
      "response": {"item": "@draft", "issues": ["@checkIssue"]},
      "body": {"ids": ["c1"]},
      "params": {"id": "{{draft.item.id}}"} },
    { "method": "POST", "path": "/api/apps/document/drafts/{id}/polish",
      "response": {"preview": "@docContent", "parts": ["@diffPart"], "changed": "boolean"},
      "body": {"style": "formal"},
      "params": {"id": "{{draft.item.id}}"} },
    { "method": "POST", "path": "/api/apps/document/drafts/{id}/comments",
      "response": {"item": "@comment"},
      "body": {"para": 0, "text": "契约测试批注"},
      "params": {"id": "{{draft.item.id}}"},
      "save": "comment" },
    { "method": "PATCH", "path": "/api/apps/document/drafts/{id}/comments/{cid}",
      "response": {"item": "@comment"},
      "body": {"reply": "已核对", "resolved": true},
      "params": {"id": "{{draft.item.id}}", "cid": "{{comment.item.id}}"} },
    { "method": "POST", "path": "/api/apps/document/drafts/{id}/submit",
      "response": {"item": "@draft", "review": "@review"},
      "body": {},
      "params": {"id": "{{draft.item.id}}"} },
    { "method": "GET", "path": "/api/apps/document/drafts/{id}/export",
      "response": {"filename": "string", "html": "string", "final": "boolean"},
      "params": {"id": "{{draft.item.id}}"} }
  ],
  "errors": [
    { "method": "GET", "path": "/api/apps/document/drafts/{id}",
      "params": {"id": "DOC-contract-missing"},
      "status": 404,
      "error": "NOT_FOUND" }
  ]
}
