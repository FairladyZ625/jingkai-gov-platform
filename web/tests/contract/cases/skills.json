{
  "routes": [
    { "method": "POST", "path": "/api/v1/skills/draft",
      "response": {"draft": {"name": "string", "icon": "string", "summary": "string", "base": "string", "spec": "@skillSpec", "questions": ["string"]}},
      "body": {"text": "根据政策资料核对申报材料是否齐全"},
      "save": "draft" },
    { "method": "POST", "path": "/api/v1/skills",
      "response": {"item": "@skill"},
      "body": {"name": "契约测试技能", "summary": "验证技能响应", "base": "kb", "spec": "{{draft.draft.spec}}"},
      "save": "skill" },
    { "method": "GET", "path": "/api/v1/skills/{id}",
      "response": {"item": "@skill", "runs": ["object"]},
      "params": {"id": "{{skill.item.id}}"} },
    { "method": "GET", "path": "/api/v1/skills/meta/options",
      "response": {"models": [{"id": "string", "name": "string"}], "spaces": ["string"], "tools": [{"id": "string", "label": "string", "needs?": "string"}], "computerTasks": [{"id": "string", "label": "string"}], "users": [{"id": "string", "name": "string", "dept": "string"}], "myDept": "string"} },
    { "method": "PATCH", "path": "/api/v1/skills/{id}",
      "response": {"item": "@skill"},
      "body": {"summary": "修改后的契约测试"},
      "params": {"id": "{{skill.item.id}}"} },
    { "method": "POST", "path": "/api/v1/skills/trial",
      "response": {"job": "@skillJob"},
      "body": {"skill": {"name": "契约试运行", "spec": {"steps": []}}, "inputs": {}} },
    { "method": "POST", "path": "/api/v1/skills/match",
      "response": {"skill": "?@skill", "score": "number"},
      "body": {"text": "zzz-无匹配契约测试-zzz"} },
    { "method": "POST", "path": "/api/v1/skills/{id}/publish",
      "response": {"item": "@skill", "review": "?@review"},
      "body": {"share": {"scope": "private", "people": [], "perm": "use"}},
      "params": {"id": "{{skill.item.id}}"},
      "save": "published" },
    { "method": "POST", "path": "/api/v1/skills/{id}/share",
      "response": {"item": "@skill", "review": "?@review"},
      "body": {"scope": "private", "people": [], "perm": "use"},
      "params": {"id": "{{skill.item.id}}"} },
    { "method": "POST", "path": "/api/v1/skills/{id}/review",
      "response": {"item": "@skill"},
      "body": {"decision": "approve", "reason": "契约测试"},
      "params": {"id": "{{skill.item.id}}"} },
    { "method": "POST", "path": "/api/v1/skills/{id}/fork",
      "response": {"item": "@skill"},
      "body": {},
      "params": {"id": "{{skill.item.id}}"} },
    { "method": "POST", "path": "/api/v1/skills/{id}/restore",
      "response": {"item": "@skill"},
      "body": {"v": "{{published.item.version}}"},
      "params": {"id": "{{skill.item.id}}"} },
    { "method": "POST", "path": "/api/v1/skills/{id}/rate",
      "response": {"item": "@skill"},
      "body": {"useful": true},
      "params": {"id": "{{skill.item.id}}"} },
    { "method": "POST", "path": "/api/v1/skills/{id}/run",
      "response": {"job": "@skillJob"},
      "body": {"inputs": {}},
      "params": {"id": "{{skill.item.id}}"},
      "save": "job" },
    { "method": "GET", "path": "/api/v1/skills/jobs/{id}",
      "response": {"job": "@skillJob"},
      "params": {"id": "{{job.job.id}}"} },
    { "method": "GET", "path": "/api/v1/skills/{id}/manifest",
      "response": {"appJson": "object", "skillMd": "string"},
      "params": {"id": "{{skill.item.id}}"} },
    { "method": "POST", "path": "/api/v1/skills/{id}/promote",
      "response": {"item": "@skill"},
      "body": {"appId": "contract-skill"},
      "params": {"id": "{{skill.item.id}}"} },
    { "method": "DELETE", "path": "/api/v1/skills/{id}",
      "response": {"ok": "boolean", "item": "@skill"},
      "params": {"id": "{{skill.item.id}}"},
      "save": "deleted" },
    { "method": "POST", "path": "/api/v1/skills/{id}/restore-deleted",
      "response": {"ok": "boolean"},
      "body": {"item": "{{deleted.item}}"},
      "params": {"id": "{{skill.item.id}}"} }
  ],
  "errors": [
    { "method": "GET", "path": "/api/v1/skills/{id}",
      "params": {"id": "SK-contract-missing"},
      "status": 404,
      "error": "NOT_FOUND" }
  ]
}
