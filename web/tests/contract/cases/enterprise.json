{
  "routes": [
    { "method": "GET", "path": "/api/apps/enterprise/companies",
      "response": {"items": ["@enterprise"], "total": "number", "facets": {"industries": ["string"], "tags": ["string"], "servicers": ["string"]}},
      "query": {"sort": "name"} },
    { "method": "POST", "path": "/api/apps/enterprise/companies",
      "response": {"item": "@enterprise"},
      "body": {"name": "北京契约测试示例有限公司", "industry": "测试", "employees": 5},
      "save": "company" },
    { "method": "GET", "path": "/api/apps/enterprise/companies/{id}",
      "response": {"item": "@enterprise", "visits": ["object"], "issues": ["@enterpriseIssue"], "files": ["object"], "proposals": ["@proposal"], "history": ["object"]},
      "params": {"id": "{{company.item.id}}"} },
    { "method": "PATCH", "path": "/api/apps/enterprise/companies/{id}",
      "response": {"item": "@enterprise"},
      "body": {"employees": 7},
      "params": {"id": "{{company.item.id}}"} },
    { "method": "GET", "path": "/api/apps/enterprise/issues",
      "response": {"items": ["@enterpriseIssue"], "statuses": ["string"]},
      "query": {"entId": "{{company.item.id}}"} },
    { "method": "POST", "path": "/api/apps/enterprise/issues",
      "response": {"item": "@enterpriseIssue"},
      "body": {"entId": "{{company.item.id}}", "title": "契约测试诉求", "from": "走访"},
      "save": "issue" },
    { "method": "PATCH", "path": "/api/apps/enterprise/issues/{id}",
      "response": {"item": "@enterpriseIssue"},
      "body": {"status": "已办结", "note": "测试处理完成"},
      "params": {"id": "{{issue.item.id}}"} },
    { "method": "GET", "path": "/api/apps/enterprise/alerts",
      "response": {"items": [{"entId": "string", "name": "string", "kind": "string", "text": "string", "level": "string"}]} },
    { "method": "GET", "path": "/api/apps/enterprise/export",
      "response": {"filename": "string", "csv": "string"},
      "query": {"ids": "{{company.item.id}}"} },
    { "method": "POST", "path": "/api/apps/enterprise/import",
      "response": {"added": "number", "items": ["@enterprise"]},
      "body": {"rows": [{"name": "契约测试导入示例公司"}]} },
    { "method": "POST", "path": "/api/apps/enterprise/companies/{id}/visits",
      "response": {"visit": {"id": "string", "entId": "string", "date": "string", "notes": "string", "followups": ["string"]}, "proposals": ["@proposal"], "issues": ["string"]},
      "body": {"notes": "项目员工有 15 人。希望了解政策。"},
      "params": {"id": "{{company.item.id}}"},
      "save": "visit" },
    { "method": "POST", "path": "/api/apps/enterprise/proposals/{id}/decision",
      "response": {"item": "@proposal", "pending": "number"},
      "body": {"decision": "reject"},
      "params": {"id": "{{visit.proposals.0.id}}"} }
  ],
  "errors": [
    { "method": "GET", "path": "/api/apps/enterprise/companies/{id}",
      "params": {"id": "E-contract-missing"},
      "status": 404,
      "error": "NOT_FOUND" }
  ]
}
