{
  "routes": [
    { "method": "GET", "path": "/api/apps/meeting/meetings",
      "response": {"items": ["@meeting"], "templates": [{"id": "string", "name": "string"}], "hotwords": ["string"]} },
    { "method": "POST", "path": "/api/apps/meeting/meetings",
      "response": {"item": "@meeting"},
      "body": {"title": "契约测试会议", "type": "企业座谈会", "participants": ["测试主持"], "file": "contract-demo.m4a", "source": "demo"},
      "save": "meeting" },
    { "method": "POST", "path": "/api/apps/meeting/meetings/{id}/transcribe",
      "response": {"job": {"id": "string", "kind": "string", "ref": "string", "status": "string",
                            "progress": "number", "step": "number", "steps": ["string"], "stepName": "?string"}},
      "body": {},
      "params": {"id": "{{meeting.item.id}}"},
      "save": "job" },
    { "method": "GET", "path": "/api/v1/jobs/{id}",
      "response": {"job": {"id": "string", "kind": "string", "ref": "string", "status": "string",
                            "progress": "number", "step": "number", "steps": ["string"], "stepName": "?string"}},
      "params": {"id": "{{job.job.id}}"} },
    { "method": "GET", "path": "/api/apps/meeting/meetings/{id}",
      "response": {"item": "@meeting", "minutes": "?@minutes"},
      "params": {"id": "{{fixture.meetingId}}"},
      "save": "ready" },
    { "method": "PATCH", "path": "/api/apps/meeting/meetings/{id}",
      "response": {"item": "@meeting", "minutes": "?@minutes"},
      "body": {"minutes": "{{ready.minutes}}"},
      "params": {"id": "{{fixture.meetingId}}"} },
    { "method": "POST", "path": "/api/apps/meeting/meetings/{id}/todos/commit",
      "response": {"committed": ["string"], "skipped": ["string|object"]},
      "body": {"ids": ["contract-missing"]},
      "params": {"id": "{{fixture.meetingId}}"} },
    { "method": "POST", "path": "/api/apps/meeting/meetings/{id}/link",
      "response": {"issue": {"id": "string", "title": "string", "entId": "string", "from": "string",
                            "owner": "string", "status": "string", "next": "string", "steps": [["string", "string"]]}},
      "body": {"entId": "{{fixture.enterpriseId}}", "title": "会议契约测试诉求"},
      "params": {"id": "{{fixture.meetingId}}"} }
  ],
  "errors": [
    { "method": "GET", "path": "/api/apps/meeting/meetings/{id}",
      "params": {"id": "MT-contract-missing"},
      "status": 404,
      "error": "NOT_FOUND" },
    { "method": "GET", "path": "/api/v1/jobs/{id}",
      "params": {"id": "JOB-contract-missing"},
      "status": 404,
      "error": "NOT_FOUND" }
  ]
}
