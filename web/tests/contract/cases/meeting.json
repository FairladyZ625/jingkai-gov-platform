{
  "routes": [
    { "method": "GET", "path": "/api/apps/meeting/meetings",
      "response": {"items": ["@meetingListItem"], "templates": [{"id": "string", "name": "string", "sections": ["string"]}], "hotwords": ["string"]} },
    { "method": "POST", "path": "/api/apps/meeting/meetings",
      "response": {"item": "@meeting"},
      "body": {"title": "契约测试会议", "type": "企业座谈会", "participants": ["测试主持"], "file": "contract-demo.m4a"},
      "save": "meeting" },
    { "method": "POST", "path": "/api/apps/meeting/meetings/{id}/transcribe",
      "response": {"job": "@meetingJob"},
      "body": {},
      "params": {"id": "{{meeting.item.id}}"},
      "save": "job" },
    { "method": "GET", "path": "/api/v1/jobs/{id}",
      "response": {"job": "@meetingJob"},
      "params": {"id": "{{job.job.id}}"} },
    { "method": "GET", "path": "/api/apps/meeting/meetings/{id}",
      "response": {"item": "@meetingDetail", "minutes": "?@minutes"},
      "params": {"id": "{{fixture.meetingId}}"},
      "save": "ready" },
    { "method": "PATCH", "path": "/api/apps/meeting/meetings/{id}",
      "response": {"item": "@meetingDetail", "minutes": "?@minutes"},
      "body": {"minutes": "{{ready.minutes}}"},
      "params": {"id": "{{meeting.item.id}}"} },
    { "method": "POST", "path": "/api/apps/meeting/meetings/{id}/todos/commit",
      "response": {"committed": ["string"], "skipped": ["string"]},
      "body": {"ids": ["contract-missing"]},
      "params": {"id": "{{fixture.meetingId}}"} },
    { "method": "POST", "path": "/api/apps/meeting/meetings/{id}/link",
      "response": {"issue": "@enterpriseIssue"},
      "body": {"entId": "{{fixture.enterpriseId}}", "title": "会议契约测试诉求"},
      "params": {"id": "{{meeting.item.id}}"} }
  ],
  "errors": [
    { "method": "GET", "path": "/api/v1/jobs/{id}",
      "params": {"id": "JOB-contract-missing"},
      "status": 404,
      "error": "NOT_FOUND" }
  ]
}
