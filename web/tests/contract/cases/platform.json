{
  "routes": [
    { "method": "GET", "path": "/api/v1/auth/session",
      "response": {"user": "?@user"} },
    { "method": "POST", "path": "/api/v1/auth/login",
      "response": {"user": "@user", "role": "@role", "grants": "@grantSet"},
      "body": "{{credentials}}" },
    { "method": "GET", "path": "/api/v1/me",
      "response": {"user": "@user", "role": "@role", "org": "@org", "settings": "object", "grants": "@grantSet"},
      "save": "me" },
    { "method": "PUT", "path": "/api/v1/me/password",
      "body": {"old": "contract-incorrect-demo-password", "new": "contract-unused-demo-password"},
      "status": 400,
      "error": "BAD_PASSWORD" },
    { "method": "PATCH", "path": "/api/v1/me/prefs",
      "response": {"prefs": {"theme": "string"}},
      "body": {"theme": "light"} },
    { "method": "GET", "path": "/api/v1/models",
      "response": {"items": ["@model"], "current": "string", "capabilities": [{"id": "string", "name": "string", "route": "string"}]},
      "save": "models" },
    { "method": "PUT", "path": "/api/v1/models/current",
      "response": {"current": "string"},
      "body": {"model": "{{models.current}}"} },
    { "method": "PATCH", "path": "/api/v1/models/{id}",
      "response": {"item": "@model"},
      "body": {"enabled": true},
      "params": {"id": "{{models.items.0.id}}"} },
    { "method": "GET", "path": "/api/v1/conversations",
      "response": {"items": ["@conversation"]} },
    { "method": "POST", "path": "/api/v1/conversations",
      "response": {"item": "@conversation"},
      "body": {"title": "契约测试对话"},
      "save": "conversation" },
    { "method": "POST", "path": "/api/v1/conversations/{id}/messages",
      "response": {"conversation": "@conversation", "user": "@message", "reply": "@reply"},
      "body": {"text": "你好，请介绍一下自己", "files": []},
      "params": {"id": "{{conversation.item.id}}"} },
    { "method": "DELETE", "path": "/api/v1/conversations/{id}",
      "response": {"ok": "boolean"},
      "params": {"id": "{{conversation.item.id}}"} },
    { "method": "GET", "path": "/api/v1/apps",
      "response": {"items": ["@appManifest"], "skills": ["@skill"]} },
    { "method": "GET", "path": "/api/v1/reviews",
      "response": {"items": ["@review"]} },
    { "method": "POST", "path": "/api/v1/reviews/{id}/decisions",
      "response": {"item": "@review"},
      "body": {"decision": "reject", "reason": "契约测试"},
      "params": {"id": "{{fixture.reviewId}}"} },
    { "method": "GET", "path": "/api/v1/todos",
      "response": {"items": ["@todo"]} },
    { "method": "PATCH", "path": "/api/v1/todos/{id}",
      "response": {"item": "@todo"},
      "body": {"done": true},
      "params": {"id": "{{fixture.todoId}}"} },
    { "method": "GET", "path": "/api/v1/feed",
      "response": {"items": [["string", "string"]]} },
    { "method": "GET", "path": "/api/v1/audit",
      "response": {"items": [["string", "string", "string", "string", "?string"]]} },
    { "method": "GET", "path": "/api/v1/kb/libraries",
      "response": {"items": [{"id": "string", "name": "string", "icon": "string", "files": "number"}]} },
    { "method": "GET", "path": "/api/v1/kb/files/{id}",
      "response": {"item": {"id": "string", "name": "string", "no": "string", "text": "string", "state": "string", "url": "string"}},
      "params": {"id": "{{fixture.kbDocId}}"} },
    { "method": "GET", "path": "/api/v1/admin/users",
      "response": {"items": ["@user"], "roles": ["@role"], "departments": ["@department"]} },
    { "method": "POST", "path": "/api/v1/admin/users",
      "response": {"item": "@user"},
      "body": {"username": "{{fixture.username}}", "name": "契约测试账号", "role": "member"},
      "save": "newUser" },
    { "method": "PATCH", "path": "/api/v1/admin/users/{id}",
      "response": {"item": "@user"},
      "body": {"title": "契约测试"},
      "params": {"id": "{{newUser.item.id}}"} },
    { "method": "POST", "path": "/api/v1/admin/departments",
      "response": {"item": "@department"},
      "body": {"name": "契约测试部门"},
      "save": "newDept" },
    { "method": "PATCH", "path": "/api/v1/admin/departments/{id}",
      "response": {"item": "@department"},
      "body": {"name": "契约测试部门（更名）"},
      "params": {"id": "{{newDept.item.id}}"} },
    { "method": "DELETE", "path": "/api/v1/admin/departments/{id}",
      "response": {"ok": "boolean"},
      "params": {"id": "{{newDept.item.id}}"} },
    { "method": "GET", "path": "/api/v1/admin/grants",
      "response": {"roles": ["@role"], "apps": [{"id": "string", "name": "string"}], "grants": "@grantMatrix", "actions": [["string", "string"]]} },
    { "method": "PUT", "path": "/api/v1/admin/grants/{role}/{app}",
      "response": {"grants": "@grantMatrix"},
      "body": {"actions": ["view", "operate"]},
      "params": {"role": "member", "app": "policy"} },
    { "method": "PATCH", "path": "/api/v1/admin/roles/{id}",
      "response": {"item": "@role"},
      "body": {"mask": true},
      "params": {"id": "partner"} },
    { "method": "PATCH", "path": "/api/v1/admin/apps/{id}",
      "response": {"item": {"id": "string", "name": "string"}},
      "body": {"status": "published"},
      "params": {"id": "policy"} },
    { "method": "GET", "path": "/api/v1/admin/settings",
      "response": {"settings": "object", "org": "@org"},
      "save": "settings" },
    { "method": "PUT", "path": "/api/v1/admin/settings",
      "response": {"settings": "object"},
      "body": {"settings": "{{settings.settings}}"} },
    { "method": "GET", "path": "/api/v1/admin/usage",
      "response": {"usage": "object", "audit": [["string", "string", "string", "string", "?string"]], "seats": "@org"} },
    { "method": "GET", "path": "/api/v1/skills",
      "response": {"items": ["@skill"], "apps": ["@appManifest"]} },
    { "method": "POST", "path": "/api/v1/demo/reset",
      "response": {"ok": "boolean"},
      "body": {} },
    { "method": "POST", "path": "/api/v1/auth/logout",
      "response": {"ok": "boolean"},
      "body": {} }
  ],
  "errors": [
    { "method": "GET", "path": "/api/v1/me",
      "status": 401,
      "error": "UNAUTHENTICATED" }
  ]
}
