#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
state=${DEMO_STATE_DIR:-/var/lib/jkq-demo}
exec 9>"$state/operation.lock"
flock -n 9 || { echo '已有部署操作进行中' >&2; exit 1; }
compose() { docker compose --env-file deploy/.env -f deploy/docker-compose.yml "$@"; }
healthy() { compose up -d --no-build --wait --wait-timeout 100; }

case "${1:-}" in
snapshot|reset)
    if [[ $1 == snapshot ]]; then
        src=$state/data
        dst=$state/snapshot
    else
        src=$state/snapshot
        dst=$state/data
    fi
    [[ -d $src && -n $(ls -A "$src") ]] || { echo '源目录为空或缺失' >&2; exit 1; }
    [[ ! -e $dst.previous ]] || { echo '上次操作中断，请检查 .previous 目录' >&2; exit 1; }
    tmp=$(mktemp -d "$state/staging.XXXXXXXX")
    trap 'rm -rf -- "$tmp"' EXIT
    running=$(compose ps -q app)
    [[ -n $running ]] || { echo "应用未运行" >&2; exit 1; }
    ref=$(docker inspect --format '{{.Config.Image}}' "$running")
    export DEMO_TAG=${ref##*:}
    compose stop app
    # Docker 需要重建容器，以重新绑定交换后的宿主目录。
    start_app() { compose up -d --no-build --force-recreate --wait --wait-timeout 100 app; }
    if ! cp -a "$src/." "$tmp/"; then start_app; exit 1; fi
    if [[ -d $dst ]]; then mv "$dst" "$dst.previous"; fi
    if ! mv "$tmp" "$dst"; then
        if [[ -d $dst.previous ]]; then mv "$dst.previous" "$dst"; fi
        start_app
        exit 1
    fi
    if ! start_app; then
        if [[ -d $dst.previous ]]; then
            compose stop app
            mv "$dst" "$tmp"
            mv "$dst.previous" "$dst"
            start_app
        fi
        exit 1
    fi
    rm -rf -- "$dst.previous"
    ;;
update)
    [[ -z $(git status --porcelain --untracked-files=normal) ]] || { echo '部署检出必须干净' >&2; exit 1; }
    old=$(git rev-parse HEAD)
    git fetch origin main
    git merge-base --is-ancestor HEAD FETCH_HEAD
    cid=$(compose ps -q app)
    [[ -n $cid ]] || { echo '请先完成首次启动' >&2; exit 1; }
    image=$(docker inspect --format '{{.Image}}' "$cid")
    DEMO_TAG=$(git rev-parse FETCH_HEAD)
    export DEMO_TAG
    if [[ $DEMO_TAG == "$old" ]]; then echo "已是最新 main"; exit 0; fi
    git merge --ff-only FETCH_HEAD
    if compose build app && healthy; then
        docker tag "$image" jkq-demo-app:previous
        docker tag "jkq-demo-app:$DEMO_TAG" jkq-demo-app:local
        printf '%s %s\n' "$old" "$image" >"$state/previous.tmp"
        mv "$state/previous.tmp" "$state/previous"
    else
        git switch --detach "$old"
        export DEMO_TAG=restored
        docker tag "$image" jkq-demo-app:restored
        healthy
        exit 1
    fi
    ;;
rollback)
    [[ -z $(git status --porcelain) ]] || { echo '部署检出必须干净' >&2; exit 1; }
    read -r rev image <"$state/previous"
    docker tag "$image" jkq-demo-app:restored
    git switch --detach "$rev"
    export DEMO_TAG=restored
    healthy
    docker tag "$image" jkq-demo-app:local
    ;;
*) echo '用法：deploy/demo snapshot|reset|update|rollback' >&2; exit 2 ;;
esac
